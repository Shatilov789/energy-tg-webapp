# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/energy_crm
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/energy_crm

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=energy_crm

# === Telegram ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_TELEGRAM_ID=0

# === App ===
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
APP_HOST=0.0.0.0
APP_PORT=8000

# === Redis (for notifications/caching) ===
REDIS_URL=redis://redis:6379/0
