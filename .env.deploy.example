# Copy to .env.deploy on the server, once per stack. Never commit the real file.

# staging for the test stack, production for the live one
APP_ENV=staging
# 8081 for the test stack, 8080 for the live one
WEB_PORT=8081

# Letters and digits only: the password is embedded in a connection URL
POSTGRES_USER=energy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=energy_crm

APP_SECRET_KEY=change-me

# Each stack needs its own bot from @BotFather
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=0
WEBAPP_URL=https://test.example.com

# Only needed when the web app is served from another origin than the API
CORS_ORIGINS=
